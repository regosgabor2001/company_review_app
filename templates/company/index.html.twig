{% extends 'base.html.twig' %}

{% block title %}Reviews{% endblock %}

{% block body %}

<div class="container py-5">

    {% for company in companies %}
    <div class="card shadow-sm mb-3 border-0">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="mb-1">
                        {{ company.companyName }}
                    </h5>
                    <small class="text-muted">
                        {{ company.reviewCount }} vélemény
                    </small>
                </div>

                <div class="fs-5">
                    {% for i in 1..5 %}
                    {% if i <= company.averageRating|round %} <i class="bi bi-star-fill text-warning"></i>
                        {% else %}
                        <i class="bi bi-star text-muted"></i>
                        {% endif %}
                        {% endfor %}
                </div>
            </div>

            <hr>

            {% set isLong = company.reviewSummary|length > 150 %}

            <p class="review-text {% if isLong %}clamped{% endif %}" id="review{{ company.companyId }}">
                {{ company.reviewSummary }}
            </p>

            {% if isLong %}
            <a href="javascript:void(0)" class="btn btn-link p-0 toggle-review" data-target="review{{ company.companyId }}">
                Teljes szöveg
            </a>
            {% endif %}

        </div>
    </div>
    {% else %}
    <div class="alert alert-info">
        Még nincsenek vélemények.
    </div>
    {% endfor %}

</div>
{% endblock %}