{% extends 'base.html.twig' %}

{% block title %}Vélemény részletei{% endblock %}

{% block body %}
<div class="container py-5">
    
    <div class="mb-4">
        <a href="{{ path('app_review_index') }}" class="btn btn-link text-decoration-none p-0 text-muted">
            <i class="bi bi-arrow-left me-1"></i> Vissza a véleményekhez
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3">
                <div>
                    <span class="text-uppercase tracking-wider text-muted small fw-bold">Értékelt cég</span>
                    <h1 class="h2 mb-0 mt-1 fw-bold text-dark">
                        {{ review.company.name }}
                    </h1>
                </div>

                <div class="fs-4 bg-light px-3 py-2 rounded-3 d-inline-flex align-items-center">
                    {% for i in 1..5 %}
                        {% if i <= review.rating %}
                            <i class="bi bi-star-fill text-warning me-1"></i>
                        {% else %}
                            <i class="bi bi-star text-muted me-1"></i>
                        {% endif %}
                    {% endfor %}
                    <span class="ms-2 small fw-bold text-secondary">({{ review.rating }}/5)</span>
                </div>
            </div>

            <hr class="my-4 text-muted opacity-25">

            <div class="mb-4 bg-light p-3 rounded-3 d-flex align-items-center">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                    <i class="bi bi-person-fill fs-5"></i>
                </div>
                <div>
                    <div class="text-muted small">Beküldő:</div>
                    <strong class="text-dark">{{ review.authorEmail }}</strong>
                </div>
            </div>

            <div class="review-content mb-4">
                <span class="text-uppercase tracking-wider text-muted small fw-bold d-block mb-2">Szöveges értékelés</span>
                <p class="fs-5 text-secondary lh-base p-3 bg-white border rounded-3" style="white-space: pre-line;">
                    {{ review.reviewText }}
                </p>
            </div>

            <hr class="my-4 text-muted opacity-25">

            <div class="row g-3 text-muted small">
                <div class="col-12 col-sm-6">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-calendar-plus me-2"></i>
                        <span>Létrehozva: <strong>{{ review.createdAt ? review.createdAt|date('Y-m-d H:i') : '-' }}</strong></span>
                    </div>
                </div>
                <div class="col-12 col-sm-6 text-sm-end">
                    <div class="d-flex align-items-center justify-content-sm-end">
                        <i class="bi bi-calendar-check me-2"></i>
                        <span>Utoljára frissítve: <strong>{{ review.updatedAt ? review.updatedAt|date('Y-m-d H:i') : '-' }}</strong></span>
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>
{% endblock %}