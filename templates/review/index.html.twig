{% extends 'base.html.twig' %}

{% block title %}Reviews{% endblock %}

{% block body %}

<div class="container py-5">

    <form method="get" class="mb-4">

        <div class="row g-2">

            <div class="col-12 col-md-6">
                <input type="text" name="search" value="{{ search }}" class="form-control"
                    placeholder="Keresés cégnév alapján...">
            </div>

            <div class="col-6 col-md-3">
                <select name="sort" class="form-select" onchange="this.form.submit()">
                    <option value="desc" {% if sort=='desc' %}selected{% endif %}>
                        Legjobb értékelések
                    </option>
                    <option value="asc" {% if sort=='asc' %}selected{% endif %}>
                        Leggyengébb értékelések
                    </option>
                </select>
            </div>

            <div class="col-6 col-md-3">
                <button class="btn btn-primary w-100">
                    Keresés
                </button>
            </div>

        </div>

    </form>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Vélemények</h1>
        <a href="{{ path('app_review_new') }}" class="btn btn-primary">
            + Új vélemény
        </a>
    </div>

    {% for review in reviews %}
    <a href="{{ path('app_review_show', {'id': review.id}) }}" class="text-decoration-none text-dark">
        <div class="card shadow-sm mb-3 border-0">
            <div class="card-body">

            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="mb-1">
                        {{ review.company.name }}
                    </h5>
                    <small class="text-muted">
                        {{ review.authorEmail }}
                    </small>
                </div>

                <div class="fs-5">
                    {% for i in 1..5 %}
                    {% if i <= review.rating %} <i class="bi bi-star-fill text-warning"></i>
                        {% else %}
                        <i class="bi bi-star text-muted"></i>
                        {% endif %}
                        {% endfor %}
                </div>
            </div>

            <hr>

            {% set isLong = review.reviewText|length > 150 %}

            <p class="review-text {% if isLong %}clamped{% endif %}" id="review{{ review.id }}">
                {{ review.reviewText }}
            </p>

            {% if isLong %}
            <a href="javascript:void(0)" class="btn btn-link p-0 toggle-review" data-target="review{{ review.id }}">
                Teljes szöveg
            </a>
            {% endif %}

            <div class="d-flex justify-content-between text-muted small">
                <div>
                    Létrehozva: {{ review.createdAt ? review.createdAt|date('Y-m-d H:i') : '-' }}
                </div>
                <div>
                    Frissítve: {{ review.updatedAt ? review.updatedAt|date('Y-m-d H:i') : '-' }}
                </div>
            </div>

        </div>
    </div></a>
    {% else %}
    <div class="alert alert-info">
        Még nincsenek vélemények.
    </div>
    {% endfor %}

    <nav class="mt-4">
        <ul class="pagination justify-content-center">

            <li class="page-item {% if page <= 1 %}disabled{% endif %}">
                <a class="page-link" href="?page={{ page - 1 }}&search={{ search }}&sort={{ sort }}">
                    Előző
                </a>
            </li>

            {% for i in 1..totalPages %}
            <li class="page-item {% if i == page %}active{% endif %}">
                <a class="page-link" href="?page={{ i }}&search={{ search }}&sort={{ sort }}">
                    {{ i }}
                </a>
            </li>
            {% endfor %}

            <li class="page-item {% if page >= totalPages %}disabled{% endif %}">
                <a class="page-link" href="?page={{ page + 1 }}&search={{ search }}&sort={{ sort }}">
                    Következő
                </a>
            </li>

        </ul>
    </nav>

</div>
{% endblock %}