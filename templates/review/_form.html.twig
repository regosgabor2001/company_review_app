{% extends 'base.html.twig' %}

{% block title %}Új vélemény{% endblock %}

{% block body %}
<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Új vélemény</h1>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            {{ form_start(form) }}

            <div class="row g-3">

                <div class="col-12">
                    {{ form_label(form.company, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.company, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.company) }}
                </div>

                <div class="col-12 col-md-4">
                    {{ form_label(form.rating, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.rating, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.rating) }}
                </div>

                <div class="col-12 col-md-8">
                    {{ form_label(form.author_email, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.author_email, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.author_email) }}
                </div>

                <div class="col-12">
                    {{ form_label(form.review_text, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.review_text, {'attr': {'class': 'form-control', 'rows': 5}}) }}
                    {{ form_errors(form.review_text) }}
                </div>

                <div class="col-12">
                    <button class="btn btn-primary w-100 w-md-auto">
                        {{ button_label|default('Mentés') }}
                    </button>
                </div>

            </div>

            {{ form_end(form) }}

        </div>
    </div>

</div>
{% endblock %}